{
  "name": "lab",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "scripts": {
    "build": "bun run --parallel --filter '@lab/*' build",
    "check": "bun run --parallel --filter '@lab/*' check",
    "dev": "bun run --parallel --filter '@lab/*' dev",
    "fmt": "prettier --write . && bun run lint:fix",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "start": "bun run --filter @lab/server start"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
