{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    ".agents/skills/",
    ".claude/skills/",
    "dist/",
    "storybook-static/"
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "plugins": [
    "eslint",
    "import",
    "jsx-a11y",
    "oxc",
    "promise",
    "react",
    "typescript",
    "unicorn"
  ],
  "rules": {
    "eslint/no-nested-ternary": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "message": "Import cn from @/lib/utils. That one merges the radius and duration tokens.",
            "name": "cn"
          }
        ]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "react/exhaustive-deps": "error",
    "react/forbid-elements": [
      "error",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use Button from components/ui/button, or add a component to components/ui."
          }
        ]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "tailwindcss/enforce-canonical": "error",
    "tailwindcss/no-arbitrary-value": [
      "error",
      {
        "allowVariables": "runtime"
      }
    ],
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-default-palette": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-dynamic-classes": "error",
    "tailwindcss/no-hardcoded-colors": "error",
    "tailwindcss/no-restricted-classes": [
      "error",
      {
        "patterns": [
          {
            "message": "Spark colors belong to the agent. Use a components/ui component that carries one, or add it there.",
            "pattern": "spark-(coral|blue|yellow)"
          }
        ]
      }
    ],
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-unnecessary-arbitrary-value": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-unsafe-type-assertion": "off"
  },
  "overrides": [
    {
      "files": ["apps/web/src/components/ui/**"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "react/forbid-elements": "off",
        "tailwindcss/no-arbitrary-value": "off",
        "tailwindcss/no-default-palette": "off",
        "tailwindcss/no-hardcoded-colors": "off",
        "tailwindcss/no-restricted-classes": [
          "error",
          {
            "patterns": [
              {
                "message": "Text takes the ink tier. Raw and wash fail contrast.",
                "pattern": "(^|:)(text|decoration|caret|placeholder)-spark-(coral|blue|yellow)(-wash)?(/|$)"
              },
              {
                "message": "A spark never colors a border, ring, or outline.",
                "pattern": "(^|:)(border|ring|outline|divide)(-[a-z]+)*-spark-"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/components/lab-mark.tsx"],
      "rules": {
        "tailwindcss/no-restricted-classes": [
          "error",
          {
            "patterns": [
              {
                "message": "Text takes the ink tier. Raw and wash fail contrast.",
                "pattern": "(^|:)(text|decoration|caret|placeholder)-spark-(coral|blue|yellow)(-wash)?(/|$)"
              },
              {
                "message": "A spark never colors a border, ring, or outline.",
                "pattern": "(^|:)(border|ring|outline|divide)(-[a-z]+)*-spark-"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/components/account-menu.tsx",
        "apps/web/src/components/approval-card.tsx",
        "apps/web/src/components/artifact-apps.tsx",
        "apps/web/src/components/command-menu.tsx",
        "apps/web/src/components/composer-attachments.tsx",
        "apps/web/src/components/conversation-item.tsx",
        "apps/web/src/components/document-card.tsx",
        "apps/web/src/components/library-tile.tsx",
        "apps/web/src/components/model-picker.tsx",
        "apps/web/src/components/project-instructions.tsx",
        "apps/web/src/components/project-menu.tsx",
        "apps/web/src/components/sidebar-sections.tsx",
        "apps/web/src/components/sidebar.tsx",
        "apps/web/src/components/tools/previews.tsx",
        "apps/web/src/components/unread-chips.tsx",
        "apps/web/src/components/usage.tsx"
      ],
      "rules": {
        "react/forbid-elements": "off"
      }
    }
  ],
  "jsPlugins": ["oxlint-tailwindcss"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "apps/web/src/index.css"
    }
  }
}
