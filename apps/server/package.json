{
  "name": "@lab/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/server.ts --target=bun --packages=external --outdir=dist",
    "check": "tsc --noEmit",
    "dev": "bun run --watch src/server.ts",
    "start": "NODE_ENV=production bun run dist/server.js"
  },
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "@lab/framework": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
