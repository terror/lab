{
  "name": "@lab/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./schemas": "./src/schemas.ts"
  },
  "scripts": {
    "build": "bun build src/server.ts --target=bun --outdir=dist --external @earendil-works/pi-codemode",
    "check": "tsc --noEmit",
    "dev": "bun run --watch src/server.ts",
    "start": "NODE_ENV=production bun run dist/server.js",
    "test": "bun test"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.25",
    "@better-auth/drizzle-adapter": "1.7.25",
    "@better-auth/expo": "1.7.25",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@hono/bun": "^1.0.1",
    "@lab/db": "workspace:*",
    "@lab/harness": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@scalar/hono-api-reference": "0.12.21",
    "@sentry/bun": "11.13.0",
    "@vercel/sandbox": "3.9.1",
    "better-auth": "1.7.25",
    "chart.js": "^4.6.1",
    "croner": "11.0.1",
    "d3": "^7.9.2",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "hono-openapi": "1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
