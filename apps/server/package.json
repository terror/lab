{
  "name": "@lab/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "check": "tsc --noEmit",
    "dev": "bun run --watch src/server.ts",
    "start": "NODE_ENV=production bun run dist/server.js"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@hono/bun": "^1.0.1",
    "@lab/harness": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
