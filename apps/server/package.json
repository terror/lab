    "@earendil-works/pi-durable": "1.0.4",
    "@hono/bun": "^1.0.1",
    "@workflow/world-local": "^5.1.2",
    "ai": "^7.0.148",
    "durable-harness": "0.0.1-beta.6",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
