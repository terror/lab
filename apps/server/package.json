{
  "name": "@lab/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/server.ts --target=bun --packages=external --outdir=dist",
    "check": "tsc --noEmit",
    "dev": "bun run --watch src/server.ts",
    "start": "NODE_ENV=production bun run dist/server.js"
  },
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "@lab/gateway-vercel": "workspace:*",
    "@lab/harness-pi": "workspace:*",
    "@lab/transport-pi-http": "workspace:*",
    "@lab/storage-workflow": "workspace:*",
    "@lab/app-protocol": "workspace:*",
    "@lab/framework": "workspace:*",
    "@lab/protocol": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
