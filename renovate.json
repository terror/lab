{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Los_Angeles",
  "rangeStrategy": "pin",
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "groupName": "earendil-works",
      "matchPackageNames": ["@earendil-works/**"]
    },
    {
      "groupName": "storybook",
      "matchPackageNames": ["storybook", "@storybook/**"]
    },
    {
      "groupName": "vitest",
      "matchPackageNames": ["vitest", "@vitest/**", "vitest-browser-react"]
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["patch"]
    },
    {
      "allowedVersions": "<4",
      "matchPackageNames": ["@vercel/sandbox"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
